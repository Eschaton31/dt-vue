{
  "name": "dt-vue",
  "version": "0.2.0",
  "description": "Declarative Vue 3 data table built on TanStack Table — sorting, grouping, totals, nested rows, range selection and Excel export.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "types"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vue-tsc --noEmit -p tests/types/tsconfig.json",
    "test:coverage": "vitest run --coverage",
    "check": "npm run test && npm run test:types && npm run build"
  },
  "keywords": [
    "vue",
    "vue3",
    "table",
    "datatable",
    "data-table",
    "tanstack",
    "tailwind"
  ],
  "peerDependencies": {
    "@heroicons/vue": "^2.1.0",
    "@tanstack/vue-table": "^8.20.0",
    "vue": "^3.4.0",
    "xlsx": "*"
  },
  "peerDependenciesMeta": {
    "xlsx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@heroicons/vue": "^2.2.0",
    "@tanstack/vue-table": "^8.21.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.9",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.12",
    "xlsx": "^0.18.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
